# Private per-user records — never committed (see CLAUDE.md §Privacy).
# Both patterns are needed: the trailing-slash form matches the real directory,
# the bare form matches the symlink used in the worktree setup (a symlink is not
# a directory to git, so the first pattern alone would let it be committed).
convos/*/private/
convos/*/private

# Working files of the error-injection review procedure (docs/procedures/code_review.md)
scratch/

# Secrets
.env

# Python
.venv/
__pycache__/

# OS noise
.DS_Store

# Course self-study (see CLAUDE.md "This Project"): code repos are cloned per coding
# day and not tracked; compiled Typst output and on-demand PDFs are rebuildable.
repos/
work/**/*.pdf
course/pdf/
